@model Hizmet
@{
    ViewData["Title"] = "Hizmet Sil";
}

<h1 class="h3 mb-3 text-danger">Hizmet Sil</h1>

<div class="alert alert-warning">
    <strong>@Model.Klinik?.Ad</strong> kliniğindeki <strong>@Model.Ad</strong> hizmetini silmek istediğinize emin misiniz? Bu işlem geri alınamaz.
</div>

<form asp-action="Sil" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Evet, sil</button>
    <a asp-action="Index" class="btn btn-link">Vazgeç</a>
</form>