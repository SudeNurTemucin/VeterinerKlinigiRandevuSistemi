@model Hizmet
@{
    ViewData["Title"] = "Hizmet Düzenle";
}

<h1 class="h3 mb-4">Hizmet Düzenle</h1>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Duzenle" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_HizmetForm" model="Model" />
            <button type="submit" class="btn btn-primary">Güncelle</button>
            <a asp-action="Index" class="btn btn-link">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}