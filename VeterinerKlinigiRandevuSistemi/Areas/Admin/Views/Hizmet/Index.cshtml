@model List<Hizmet>
@{
    ViewData["Title"] = "Hizmetler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Hizmetler</h1>
    <a asp-action="Ekle" class="btn btn-success">+ Yeni Hizmet</a>
</div>

@* Klinik filtresi: get formu, seçim adres çubuğuna ?klinikId=2 olarak yazılır *@
<form asp-action="Index" method="get" class="row g-2 align-items-center mb-3">
    <div class="col-auto">
        <label for="klinikFiltre" class="col-form-label">Klinik:</label>
    </div>
    <div class="col-auto">
        <select id="klinikFiltre" name="klinikId" class="form-select" asp-items="(SelectList)ViewBag.Klinikler">
            <option value="">Tüm klinikler</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filtrele</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">Gösterilecek hizmet yok.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Hizmet</th>
                <th>Klinik</th>
                <th>Süre</th>
                <th>Ücret</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var hizmet in Model)
            {
                <tr>
                    <td>@hizmet.Ad</td>
                    <td>@hizmet.Klinik?.Ad</td>
                    <td>@hizmet.SureDakika dk</td>
                    <td>@hizmet.Ucret.ToString("C")</td>
                    <td class="text-end">
                        <a asp-action="Detay" asp-route-id="@hizmet.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                        <a asp-action="Duzenle" asp-route-id="@hizmet.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <a asp-action="Sil" asp-route-id="@hizmet.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Panel" asp-action="Index">&larr; Panele dön</a>

@section Scripts {
    <script>
        // jQuery: klinik seçimi değişince "Filtrele"ye basmaya gerek kalmadan formu gönderir.
        $(function () {
            $('#klinikFiltre').on('change', function () {
                $(this).closest('form').trigger('submit');
            });
        });
    </script>
}