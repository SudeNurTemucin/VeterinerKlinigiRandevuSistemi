@model Hizmet

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="KlinikId" class="form-label"></label>
    <select asp-for="KlinikId" asp-items="(SelectList)ViewBag.Klinikler" class="form-select">
        <option value="">-- Klinik seçiniz --</option>
    </select>
    <span asp-validation-for="KlinikId" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Ad" class="form-label"></label>
    <input asp-for="Ad" class="form-control" />
    <span asp-validation-for="Ad" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Aciklama" class="form-label"></label>
    <textarea asp-for="Aciklama" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Aciklama" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="SureDakika" class="form-label"></label>
        <input asp-for="SureDakika" class="form-control" />
        <span asp-validation-for="SureDakika" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Ucret" class="form-label"></label>
        <div class="input-group">
            <input asp-for="Ucret" class="form-control" />
            <span class="input-group-text">₺</span>
        </div>
        <div class="form-text">Kuruş için virgül kullanın: 450,50</div>
        <span asp-validation-for="Ucret" class="text-danger"></span>
    </div>
</div>