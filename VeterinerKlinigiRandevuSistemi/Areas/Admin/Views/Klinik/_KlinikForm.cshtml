@model Klinik

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="Ad" class="form-label"></label>
    <input asp-for="Ad" class="form-control" />
    <span asp-validation-for="Ad" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Adres" class="form-label"></label>
    <textarea asp-for="Adres" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Adres" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Telefon" class="form-label"></label>
    <input asp-for="Telefon" class="form-control" />
    <span asp-validation-for="Telefon" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="AcilisSaati" class="form-label"></label>
        <input asp-for="AcilisSaati" class="form-control" />
        <span asp-validation-for="AcilisSaati" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="KapanisSaati" class="form-label"></label>
        <input asp-for="KapanisSaati" class="form-control" />
        <span asp-validation-for="KapanisSaati" class="text-danger"></span>
    </div>
</div>
