@model AsiKaydiFormViewModel
@{
    ViewData["Title"] = "Aşı Kaydı Düzenle: " + Model.HayvanAdi;
}

<h1 class="h3 mb-4">@Model.HayvanAdi - Aşı Kaydı Düzenle</h1>

<div class="row">
    <div class="col-lg-7">
        <form asp-action="Duzenle" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_AsiKaydiForm" model="Model" />
            <button type="submit" class="btn btn-primary">Güncelle</button>
            <a asp-controller="EvcilHayvan" asp-action="Detay" asp-route-id="@Model.EvcilHayvanId" class="btn btn-link">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/asi-formu.js" asp-append-version="true"></script>
}