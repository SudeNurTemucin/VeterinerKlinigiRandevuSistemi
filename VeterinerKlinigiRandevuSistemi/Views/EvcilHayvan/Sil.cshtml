@model EvcilHayvan
@{
    ViewData["Title"] = "Sil: " + Model.Ad;
}

<h1 class="h3 mb-3 text-danger">Evcil Hayvanı Sil</h1>

<div class="alert alert-warning">
    <strong>@Model.Ad</strong> (@Model.Tur) ve tüm aşı kayıtları silinecek. Bu işlem geri alınamaz.
</div>

<form asp-action="Sil" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Evet, sil</button>
    <a asp-action="Detay" asp-route-id="@Model.Id" class="btn btn-link">Vazgeç</a>
</form>