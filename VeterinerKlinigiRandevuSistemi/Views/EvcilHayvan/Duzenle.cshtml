@model EvcilHayvanFormViewModel
@{
    ViewData["Title"] = "Düzenle: " + Model.Ad;
}

<h1 class="h3 mb-4">@Model.Ad - Düzenle</h1>

<div class="row">
    <div class="col-lg-7">
        <form asp-action="Duzenle" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <partial name="_EvcilHayvanForm" model="Model" />
            <button type="submit" class="btn btn-primary">Güncelle</button>
            <a asp-action="Detay" asp-route-id="@Model.Id" class="btn btn-link">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/fotograf-onizleme.js" asp-append-version="true"></script>
}